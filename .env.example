# =============================================================================
# Chin Hin Intelligent Credit Assessment Copilot — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in real values before running the backend.
# NEVER commit .env — it is blocked by .gitignore.
# =============================================================================

# ---------------------------------------------------------------------------
# Azure AI Foundry — Project Coordinates
# ---------------------------------------------------------------------------
AZURE_EXISTING_AIPROJECT_ENDPOINT="https://<your-project>.api.azureml.ms"
AZURE_EXISTING_AIPROJECT_RESOURCE_ID="/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.MachineLearningServices/workspaces/<project>"
AZURE_EXISTING_RESOURCE_ID="/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<account>"

# ---------------------------------------------------------------------------
# Azure Subscription & Region
# ---------------------------------------------------------------------------
AZURE_SUBSCRIPTION_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
AZURE_LOCATION="eastus2"

# ---------------------------------------------------------------------------
# Azure Developer CLI (azd) — optional, used by azd up / azd provision
# ---------------------------------------------------------------------------
AZURE_ENV_NAME="chin-hin-credit-engine"
AZD_ALLOW_NON_EMPTY_FOLDER="true"

# ---------------------------------------------------------------------------
# Agent IDs — Credit Pipeline (copy from Azure AI Foundry portal)
# ---------------------------------------------------------------------------
CTOS_AGENT_ID="asst_xxxxxxxxxxxxxxxxxxxxxxxx"
ERP_AGENT_ID="asst_xxxxxxxxxxxxxxxxxxxxxxxx"
BANK_AGENT_ID="asst_xxxxxxxxxxxxxxxxxxxxxxxx"
CHIEF_AGENT_ID="asst_xxxxxxxxxxxxxxxxxxxxxxxx"

# ---------------------------------------------------------------------------
# Agent IDs — AI Data Copilot (optional — sensible defaults are built-in)
# These power the natural-language form editing & Q&A sidebar.
# If omitted, the copilot falls back to "Planner-Agent:1" / "Merge-Agent:1".
# ---------------------------------------------------------------------------
# PLANNER_AGENT_ID="Planner-Agent:1"
# MERGE_AGENT_ID="Merge-Agent:1"
